# Build output
dist/
dist-ssr/

# Environment variables (local overrides only; committed defaults are .env.development etc.)
.env*.local

# Common ignores
node_modules
.DS_Store
*.log
logs
.vite/

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# This is a standalone single-package app, NOT a pnpm monorepo. A
# pnpm-workspace.yaml here forces pnpm into workspace mode and breaks
# `pnpm install` with "packages field missing or empty" (esp. in CI).
# pnpm/tooling sometimes regenerates this file — keep it out of the repo.
pnpm-workspace.yaml
