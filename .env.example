# Copy to .env.development.local for local overrides.
# Base URL for the backend API (Spring Boot). Must include the /api/v1 prefix.
VITE_API_BASE_URL=https://api.magizhmatrimony.com/api/v1

# Google reCAPTCHA v2 site key (public, safe client-side). Login/Register use it.
# Google's published TEST key below always passes on any host including localhost.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# TEST ONLY — must match otp.test-bypass-code in the backend. Auto-fills OTP
# inputs for faster manual testing. Leave unset in production.
VITE_OTP_TEST_BYPASS_CODE=
