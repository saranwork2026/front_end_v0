# Local dev points at the production backend (no local backend available).
# NOTE: the production backend's CORS allows the site domains, not
# http://localhost:3000. Cross-origin cookie auth from localhost may be blocked
# by the browser. See src/lib/api.ts and the dev proxy in vite.config.ts.
VITE_API_BASE_URL=https://api.magizhmatrimony.com/api/v1

VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

VITE_OTP_TEST_BYPASS_CODE=

# The production backend currently accepts "disabled" as a captcha token
# (verified against api.magizhmatrimony.com — a wrong-password login returns
# INVALID_CREDENTIALS, not a captcha error). So we keep the lightweight
# checkbox UI and send "disabled". Set to false + provide a real site key to
# enable a real reCAPTCHA widget.
VITE_CAPTCHA_DISABLED=true
